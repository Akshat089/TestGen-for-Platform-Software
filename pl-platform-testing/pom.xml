<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>in.ac.iiitb.plproject</groupId>
    <artifactId>pl-platform-testing</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>PL Platform Testing</name>
    <description>Test generation algorithm platform (GENATC): spec + sequence -&gt; IR -&gt; real SPF -&gt; JUnit</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- jpf-core/jpf-symbc (installed by ../scripts/setup-spf.sh) are built and run
             under JDK 11; this module targets the same JDK throughout for one fixed
             point rather than two. -->
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <!-- Rule 11: one JUnit version everywhere — the generated test classes, this
             module's own tests, and verify-generated.sh all use JUnit 4. -->
        <junit.version>4.13.1</junit.version>
        <hamcrest.version>1.3</hamcrest.version>
        <!-- Pinned by scripts/setup-spf.sh; see IMPLEMENTATION_NOTES.md for the exact
             commits these coordinates were installed from. -->
        <jpf-core.version>8.0-f70927c</jpf-core.version>
        <jpf-symbc.version>1.0-3bedf0b</jpf-symbc.version>
    </properties>

    <dependencies>
        <!-- Real JUnit 4: both this module's own tests and the generated JUnit classes
             run on it (rule 11). -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
        </dependency>

        <!-- jpf-core / jpf-symbc: `provided` scope only. The generator's own compiled
             code needs them for exactly one class, the JPF path-vector listener
             (in.ac.iiitb.plproject.spf.listener.PathVectorListener) — everything else,
             including every generated JUnit class, imports nothing from gov.nasa.jpf
             (rule 11). Not on Maven Central; installed locally by
             ../scripts/setup-spf.sh, which this module's build therefore depends on
             having been run at least once. -->
        <dependency>
            <groupId>gov.nasa.jpf</groupId>
            <artifactId>jpf-core</artifactId>
            <version>${jpf-core.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>gov.nasa.jpf</groupId>
            <artifactId>jpf-symbc</artifactId>
            <version>${jpf-symbc.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <outputDirectory>target/classes</outputDirectory>
        <testOutputDirectory>target/test-classes</testOutputDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M7</version>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <trimStackTrace>false</trimStackTrace>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>in.ac.iiitb.plproject.atc.GenatcMain</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
