/*
 * EXAMPLE 4 — TicketService, singular case.
 *
 * The venue starts with 12 free seats, so the run reads the count, holds three
 * of them, commits that hold, and reads the count again.  Bracketing the hold
 * with the same query is the point: numSeatsAvailable appears twice, produces a
 * SERVER_OUTPUT in each block, and the two captures must stay independent — the
 * first must not be threaded into the second.
 *
 * seatHoldId is NOT bound here.  The venue assigns it, so the caller cannot know
 * it before the call; it is captured from findAndHoldSeats and threaded into
 * reserveSeats by the propagation scan.  Binding it would be rejected by the
 * validator.
 *
 * customerEmail IS bound twice, once per block that names it, because it is a
 * CLIENT_INPUT in both.  Both bindings carry the same address on purpose:
 * reserveSeats' precondition requires the claimer to be the original holder.
 */
test TicketServiceDryRun {
    sequence: numSeatsAvailable -> findAndHoldSeats -> reserveSeats -> numSeatsAvailable -> findAndHoldSeats -> findAndHoldSeats -> reserveSeats -> numSeatsAvailable -> reserveSeats -> findAndHoldSeats -> numSeatsAvailable -> findAndHoldSeats -> reserveSeats -> reserveSeats -> numSeatsAvailable -> findAndHoldSeats -> findAndHoldSeats -> numSeatsAvailable -> reserveSeats -> findAndHoldSeats -> reserveSeats -> reserveSeats -> numSeatsAvailable;

    inputs {
        findAndHoldSeats[1].numSeats = 2;
        findAndHoldSeats[1].customerEmail = "alice@example.com";
        reserveSeats[2].customerEmail = "alice@example.com";
        findAndHoldSeats[4].numSeats = 1;
        findAndHoldSeats[4].customerEmail = "bob@example.com";
        findAndHoldSeats[5].numSeats = 2;
        findAndHoldSeats[5].customerEmail = "carol@example.com";
        reserveSeats[6].customerEmail = "bob@example.com";
        reserveSeats[8].customerEmail = "carol@example.com";
        findAndHoldSeats[9].numSeats = 1;
        findAndHoldSeats[9].customerEmail = "dave@example.com";
        findAndHoldSeats[11].numSeats = 1;
        findAndHoldSeats[11].customerEmail = "erin@example.com";
        reserveSeats[12].customerEmail = "dave@example.com";
        reserveSeats[13].customerEmail = "erin@example.com";
        findAndHoldSeats[15].numSeats = 1;
        findAndHoldSeats[15].customerEmail = "frank@example.com";
        findAndHoldSeats[16].numSeats = 2;
        findAndHoldSeats[16].customerEmail = "grace@example.com";
        reserveSeats[18].customerEmail = "frank@example.com";
        findAndHoldSeats[19].numSeats = 1;
        findAndHoldSeats[19].customerEmail = "heidi@example.com";
        reserveSeats[20].customerEmail = "grace@example.com";
        reserveSeats[21].customerEmail = "heidi@example.com";
    }
}
